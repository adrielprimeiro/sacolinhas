# Sacolinhas OBS Agent — Configuração
# Copie este arquivo para .env e preencha os valores

# URL do seu servidor web (sem barra no final)
SERVER_URL=https://vps55549.publiccloud.com.br

# Token de API para autenticação (gerado em /admin/profile ou via artisan)
# Deixe vazio se o relay for por sessão autenticada (não recomendado)
SERVER_TOKEN=

# OBS WebSocket (local — este PC)
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# Intervalo de polling em milissegundos (padrão: 1500ms = ~0.6s de delay máximo)
POLL_MS=1500
