          @forelse ($item->medias as $media)
            <div class="relative group">
              @php
                $rawUrl = $media->thumbnail_url ?: $media->url;
                $isAbsolute = $rawUrl && (str_starts_with($rawUrl, 'http://') || str_starts_with($rawUrl, 'https://'));
                $normalized = $rawUrl ? ltrim($rawUrl, '/') : null;

                if ($isAbsolute) {
                  $finalUrl = $rawUrl;
                } elseif ($normalized && str_starts_with($normalized, 'storage/')) {
                  $finalUrl = url('/' . $normalized);
                } elseif ($normalized) {
                  $finalUrl = asset('storage/' . $normalized);
                } else {
                  $finalUrl = null;
                }

                $ext = $rawUrl ? strtolower(pathinfo(parse_url($rawUrl, PHP_URL_PATH) ?? $rawUrl, PATHINFO_EXTENSION)) : null;
                $isImageByExt = in_array($ext, ['jpg','jpeg','png','webp','gif','heic','heif']);
                $isImage = ($media->media_type === 'image') || $isImageByExt;
              @endphp

              @if($isImage)
                @if($finalUrl)
                  <img src="{{ $finalUrl }}"
                       alt="{{ $media->alt_text ?? 'Mídia do item' }}"
                       class="w-full h-24 object-cover rounded-md border border-gray-200">
                @else
                  <div class="w-full h-24 rounded-md border border-gray-200 bg-gray-50 flex items-center justify-center text-xs text-gray-500">
