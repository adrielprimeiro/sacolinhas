@push('scripts')
<script src="https://unpkg.com/html5-qrcode"></script>
<meta name="csrf-token" content="{{ csrf_token() }}">

<script>
(function () {
  const addBtn = document.getElementById('addMediaPlaceholder');
  const input = document.getElementById('new_media');
  const grid = document.getElementById('mediaGrid');
  const overlay = document.getElementById('uploadOverlay');

  const uploadUrl = "{{ route('items.media.upload', $item) }}";

  function csrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  }

  function showOverlay() {
    if (!overlay) return;
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
  }

  function hideOverlay() {
    if (!overlay) return;
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
  }

  function addLoadingCard() {
    if (!grid) return null;
    const card = document.createElement('div');
    card.className = 'rounded-md border border-gray-200 bg-gray-50 w-full h-24 flex items-center justify-center text-xs text-gray-600';
    card.textContent = 'Carregando...';
    grid.prepend(card);
    return card;
  }

  async function uploadFiles(files) {
    const fd = new FormData();
    for (const f of files) fd.append('new_media[]', f);

    const resp = await fetch(uploadUrl, {
      method: 'POST',
      headers: { 'X-CSRF-TOKEN': csrfToken(), 'Accept': 'application/json' },
      body: fd,
    });

    const ct = resp.headers.get('content-type') || '';
    if (!ct.includes('application/json')) {
      const text = await resp.text();
      console.error('Resposta não-JSON:', text.slice(0, 400));
      throw new Error('Upload não retornou JSON (provável redirect/HTML).');
    }

    const data = await resp.json();
    if (!resp.ok || !data.ok) {
      console.error(data);
      throw new Error('Falha ao enviar a mídia.');
    }
    return data;
  }

  if (addBtn && input) {
    addBtn.addEventListener('click', () => input.click());

    input.addEventListener('change', async () => {
      if (!input.files || !input.files.length) return;

      const loadingCard = addLoadingCard();
      showOverlay();

      try {
        const data = await uploadFiles(input.files);

        if (loadingCard) loadingCard.remove();

        if (grid && Array.isArray(data.media)) {
          data.media.forEach(m => {
            const imgSrc = m.final_url || m.thumb || m.url || null;
            if (!imgSrc) return;

            const wrap = document.createElement('div');
            wrap.className = 'relative group';

            if (m.media_type === 'image') {
              wrap.innerHTML = `<img src="${imgSrc}" class="w-full h-24 object-cover rounded-md border border-gray-200" alt="Mídia do item">`;
            } else {
              wrap.innerHTML = `
                <img src="${imgSrc}" class="w-full h-24 object-cover rounded-md border border-gray-200" alt="Vídeo do item">
                <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-30 rounded-md">
                  <i class="fas fa-play text-white text-2xl"></i>
                </div>
              `;
            }

            grid.prepend(wrap);
          });
        }
      } catch (e) {
        console.error(e);
        if (loadingCard) loadingCard.remove();
        alert('Falha no upload. Verifique a rota de upload (deve retornar JSON).');
      } finally {
        hideOverlay();
        input.value = '';
      }
    });
  }

  // QR code (mantém seu código original; se quiser, eu encaixo aqui)
})();
</script>
@endpush