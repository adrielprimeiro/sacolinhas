{
  "manifest_version": 3,
  "name": "Capturador de Live - Minha Mania",
  "version": "1.7",
  "description": "Extensão Oficial Minha Mania (v1.7 Automática) - Captura em tempo real no Instagram e TikTok para minhamania.net.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://instagram.com/*",
        "https://*.tiktok.com/*",
        "https://tiktok.com/*",
        "http://*.tiktok.com/*",
        "http://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
