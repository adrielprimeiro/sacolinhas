<?php

namespace App\Http\Controllers;

use App\Models\Cliente;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Validator;
use Illuminate\Validation\Rule;

class ClienteController extends Controller
{
    /**
     * Display a listing of the resource.
     */
    public function index(Request $request)
    {
        $query = Cliente::query(); 

        // Aplicar filtros de busca
        if ($request->filled('search')) {
            $query->buscar($request->get('search')); // Usando scope
        }

        // Filtro por status
        if ($request->filled('status')) {
            if ($request->get('status') === 'bloqueado') {
                $query->bloqueados(); // Usando scope
            } elseif ($request->get('status') === 'ativo') {
                $query->ativos(); // Usando scope
            }
        }

        // Filtro por cidade
        if ($request->filled('cidade')) {
            $query->porCidade($request->get('cidade')); // Usando scope
        }

        // Ordenação
        $sortBy = $request->get('sort', 'nome_cliente');
        $sortDirection = $request->get('direction', 'asc');
        
        $allowedSorts = ['nome_cliente', 'email', 'created_at', 'ultima_compra', 'total_pedidos'];
        if (!in_array($sortBy, $allowedSorts)) {
            $sortBy = 'nome_cliente';
        }

        $clientes = $query->orderBy($sortBy, $sortDirection)
                         ->paginate(15)
                         ->withQueryString();

        return view('clientes.index', compact('clientes'));
    }

    /**
     * Show the form for creating a new resource.
     */
    public function create()
    {
        $estados = $this->getEstadosBrasileiros();
        return view('clientes.create', compact('estados'));
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store(Request $request)
    {
        $validator = $this->getValidationRules($request);

        if ($validator->fails()) {
            return redirect()->back()
                           ->withErrors($validator)
                           ->withInput();
        }

        try {
            $dados = $request->all();
            
            // Limpar formatação de campos
            $dados['cpf'] = $this->limparFormatacao($dados['cpf'] ?? '');
            $dados['cep'] = $this->limparFormatacao($dados['cep'] ?? '');
            $dados['telefone_principal'] = $this->limparFormatacao($dados['telefone_principal'] ?? '');
            $dados['telefone_2'] = $this->limparFormatacao($dados['telefone_2'] ?? '');

            // Hash da senha
            if (!empty($dados['password'])) {
                $dados['password'] = Hash::make($dados['password']);
            }

            // Definir valores padrões
            $dados['role'] = 'client';
            $dados['is_admin'] = false;
            $dados['data_cadastro'] = now();
            $dados['bloqueado'] = $request->has('bloqueado') ? 1 : 0;

            // Gerar código do cliente único
            $dados['codigo_cliente'] = $this->gerarCodigoCliente();

            $cliente = User::create($dados);

            return redirect()
                ->route('clientes.show', $cliente)
                ->with('success', 'Cliente cadastrado com sucesso!');

        } catch (\Exception $e) {
            return redirect()->back()
                           ->with('error', 'Erro ao cadastrar cliente: ' . $e->getMessage())
                           ->withInput();
        }
    }

    /**
     * Display the specified resource.
     */
    public function show(User $cliente)
    {
        // Verificar se é realmente um cliente
        if ($cliente->role !== 'client') {
            abort(404, 'Cliente não encontrado');
        }

        return view('clientes.show', compact('cliente'));
    }

    /**
     * Show the form for editing the specified resource.
     */
    public function edit(User $cliente)
    {
        if ($cliente->role !== 'client') {
            abort(404, 'Cliente não encontrado');
        }

        $estados = $this->getEstadosBrasileiros();
        return view('clientes.edit', compact('cliente', 'estados'));
    }

    /**
     * Update the specified resource in storage.
     */
    public function update(Request $request, User $cliente)
    {
        if ($cliente->role !== 'client') {
            abort(404, 'Cliente não encontrado');
        }

        $validator = $this->getValidationRules($request, $cliente->id);

        if ($validator->fails()) {
            return redirect()->back()
                           ->withErrors($validator)
                           ->withInput();
        }

        try {
            $dados = $request->all();
            
            // Limpar formatação de campos
            $dados['cpf'] = $this->limparFormatacao($dados['cpf'] ?? '');
            $dados['cep'] = $this->limparFormatacao($dados['cep'] ?? '');
            $dados['telefone_principal'] = $this->limparFormatacao($dados['telefone_principal'] ?? '');
            $dados['telefone_2'] = $this->limparFormatacao($dados['telefone_2'] ?? '');

            // Atualizar senha apenas se fornecida
            if (!empty($dados['password'])) {
                $dados['password'] = Hash::make($dados['password']);
            } else {
                unset($dados['password']);
            }

            // Status de bloqueio
            $dados['bloqueado'] = $request->has('bloqueado') ? 1 : 0;

            $cliente->update($dados);

            return redirect()
                ->route('clientes.show', $cliente)
                ->with('success', 'Cliente atualizado com sucesso!');

        } catch (\Exception $e) {
            return redirect()->back()
                           ->with('error', 'Erro ao atualizar cliente: ' . $e->getMessage())
                           ->withInput();
        }
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy(User $cliente)
    {
        if ($cliente->role !== 'client') {
            abort(404, 'Cliente não encontrado');
        }

        try {
            // Verificar se cliente tem pedidos
            if ($cliente->total_pedidos > 0) {
                return redirect()->back()
                               ->with('warning', 'Não é possível excluir cliente com pedidos registrados. Considere bloqueá-lo.');
            }

            $nome = $cliente->nome_cliente ?? $cliente->name;
            $cliente->delete();

            return redirect()
                ->route('clientes.index')
                ->with('success', "Cliente {$nome} excluído com sucesso!");

        } catch (\Exception $e) {
            return redirect()->back()
                           ->with('error', 'Erro ao excluir cliente: ' . $e->getMessage());
        }
    }

    /**
     * Toggle do status de bloqueio do cliente
     */
    public function toggleBlock(User $cliente)
    {
        if ($cliente->role !== 'client') {
            abort(404, 'Cliente não encontrado');
        }

        try {
            $cliente->bloqueado = !$cliente->bloqueado;
            $cliente->save();

            $status = $cliente->bloqueado ? 'bloqueado' : 'desbloqueado';
            $nome = $cliente->nome_cliente ?? $cliente->name;

            return redirect()->back()
                           ->with('success', "Cliente {$nome} {$status} com sucesso!");

        } catch (\Exception $e) {
            return redirect()->back()
                           ->with('error', 'Erro ao alterar status do cliente: ' . $e->getMessage());
        }
    }

    /**
     * Regras de validação
     */
    private function getValidationRules(Request $request, $clienteId = null)
    {
        $rules = [
            'email' => [
                'required',
                'email',
                'max:255',
                Rule::unique('users', 'email')->ignore($clienteId),
            ],
            'cpf' => [
                'nullable',
                'string',
                Rule::unique('users', 'cpf')->ignore($clienteId),
            ],
            'sexo' => 'nullable|in:M,F,Outro',
            'observacao_cliente' => 'nullable|string',
        ];

        $messages = [
            'nome_cliente.required' => 'O nome do cliente é obrigatório.',
            'email.required' => 'O e-mail é obrigatório.',
            'email.email' => 'Digite um e-mail válido.',
            'email.unique' => 'Este e-mail já está cadastrado.',
            'password.required' => 'A senha é obrigatória.',
            'password.min' => 'A senha deve ter pelo menos 8 caracteres.',
            'password.confirmed' => 'A confirmação da senha não confere.',
            'cpf.unique' => 'Este CPF já está cadastrado.',
            'data_nascimento.before' => 'A data de nascimento deve ser anterior a hoje.',
            'estado.size' => 'O estado deve ter exatamente 2 caracteres.',
            'sexo.in' => 'Selecione uma opção válida para o sexo.',
        ];

        return Validator::make($request->all(), $rules, $messages);
    }

    /**
     * Gerar código único para cliente
     */
    private function gerarCodigoCliente()
    {
        do {
            $codigo = mt_rand(100000, 999999);
        } while (User::where('codigo_cliente', $codigo)->exists());

        return $codigo;
    }

    /**
     * Limpar formatação de campos (CPF, telefone, CEP)
     */
    private function limparFormatacao($valor)
    {
        return preg_replace('/[^0-9]/', '', $valor);
    }

    /**
     * Lista de estados brasileiros
     */
    private function getEstadosBrasileiros()
    {
        return [
            'AC' => 'Acre',
            'AL' => 'Alagoas',
            'AP' => 'Amapá',
            'AM' => 'Amazonas',
            'BA' => 'Bahia',
            'CE' => 'Ceará',
            'DF' => 'Distrito Federal',
            'ES' => 'Espírito Santo',
            'GO' => 'Goiás',
            'MA' => 'Maranhão',
            'MT' => 'Mato Grosso',
            'MS' => 'Mato Grosso do Sul',
            'MG' => 'Minas Gerais',
            'PA' => 'Pará',
            'PB' => 'Paraíba',
            'PR' => 'Paraná',
            'PE' => 'Pernambuco',
            'PI' => 'Piauí',
            'RJ' => 'Rio de Janeiro',
            'RN' => 'Rio Grande do Norte',
            'RS' => 'Rio Grande do Sul',
            'RO' => 'Rondônia',
            'RR' => 'Roraima',
            'SC' => 'Santa Catarina',
            'SP' => 'São Paulo',
            'SE' => 'Sergipe',
            'TO' => 'Tocantins',
        ];
    }
	/**
	 * Busca AJAX para clientes
	 */
	public function search(Request $request)
	{
		$query = Cliente::query();
		
		if ($request->filled('term')) {
			$query->buscar($request->get('term'));
		}
		
		$clientes = $query->limit(10)->get()->map(function ($cliente) {
			return [
				'id' => $cliente->id,
				'text' => $cliente->nome_exibicao,
				'email' => $cliente->email,
				'cpf' => $cliente->cpf_formatado,
				'telefone' => $cliente->telefone_formatado,
				'codigo' => $cliente->codigo_cliente,
			];
		});
		
		return response()->json(['results' => $clientes]);
	}

	/**
	 * Buscar cliente por CPF (AJAX)
	 */
	public function buscarPorCpf($cpf)
	{
		$cliente = Cliente::buscarPorCpf($cpf);
		
		if (!$cliente) {
			return response()->json(['error' => 'Cliente não encontrado'], 404);
		}
		
		return response()->json([
			'id' => $cliente->id,
			'nome' => $cliente->nome_completo,
			'email' => $cliente->email,
			'telefone' => $cliente->telefone_formatado,
			'endereco' => $cliente->endereco_completo,
		]);
	}

	/**
	 * Estatísticas dos clientes (AJAX)
	 */
	public function estatisticas()
	{
		return response()->json(Cliente::estatisticas());
	}

	/**
	 * Histórico do cliente (AJAX)
	 */
	public function historico(Cliente $cliente)
	{
		// Se você tiver tabela de pedidos/histórico
		// $historico = $cliente->pedidos()->latest()->take(10)->get();
		
		return response()->json([
			'cliente' => $cliente->nome_completo,
			'total_pedidos' => $cliente->total_pedidos,
			'ultima_compra' => $cliente->ultima_compra?->format('d/m/Y H:i'),
			'ultima_visita' => $cliente->ultima_visita?->format('d/m/Y H:i'),
			'tempo_cliente' => $cliente->tempo_como_cliente,
			// 'historico' => $historico
		]);
	}

	/**
	 * Exportar clientes
	 */
	public function export($format = 'excel')
	{
		$clientes = Cliente::all();
		
		switch ($format) {
			case 'csv':
				return $this->exportToCsv($clientes);
			case 'pdf':
				return $this->exportToPdf($clientes);
			default:
				return $this->exportToExcel($clientes);
		}
	}

	/**
	 * Relatórios administrativos
	 */
	public function relatorios()
	{
		$estatisticas = Cliente::estatisticas();
		
		$clientesPorCidade = Cliente::selectRaw('cidade, COUNT(*) as total')
								   ->whereNotNull('cidade')
								   ->groupBy('cidade')
								   ->orderBy('total', 'desc')
								   ->limit(10)
								   ->get();
		
		$clientesPorMes = Cliente::selectRaw('MONTH(data_cadastro) as mes, YEAR(data_cadastro) as ano, COUNT(*) as total')
								->whereYear('data_cadastro', now()->year)
								->groupBy('mes', 'ano')
								->orderBy('mes')
								->get();
		
		return view('admin.clientes.relatorios', compact('estatisticas', 'clientesPorCidade', 'clientesPorMes'));
	}

