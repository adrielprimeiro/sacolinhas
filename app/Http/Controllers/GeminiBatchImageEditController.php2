<?php

namespace App\Http\Controllers;

use App\Jobs\SubmitGeminiImageBatchJob;
use App\Services\ImageEditing\GeminiBatchImageEditService;
use Illuminate\Http\Request;

class GeminiBatchImageEditController extends Controller
{
    public function submit(Request $request)
    {
        $data = $request->validate([
            'items' => ['required', 'array', 'min:1'],
            'items.*.image_path' => ['required', 'string'],
            'items.*.prompt' => ['nullable', 'string'],
            'items.*.custom_id' => ['nullable', 'string'],
        ]);

        SubmitGeminiImageBatchJob::dispatch($data['items'], auth()->id());

        return response()->json([
            'success' => true,
            'message' => 'Lote enviado para processamento.',
        ]);
    }

    public function show(int $batchId, GeminiBatchImageEditService $service)
    {
        $result = $service->getBatchWithItems($batchId);

        return response()->json($result, $result['success'] ? 200 : 404);
    }

    public function status(int $batchId, GeminiBatchImageEditService $service)
    {
        $result = $service->syncBatchStatus($batchId);

        return response()->json($result, $result['success'] ? 200 : 422);
    }
}